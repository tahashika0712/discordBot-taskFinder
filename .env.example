# Discord Bot
DISCORD_BOT_TOKEN=

# Anthropic Claude API
ANTHROPIC_API_KEY=
# 省略時のデフォルトは claude-opus-4-8。コスト重視なら claude-sonnet-5 / claude-haiku-4-5 に変更可
CLAUDE_MODEL=claude-opus-4-8

# トリガーとなる絵文字（デフォルト: 📋）
TRIGGER_EMOJI=📋

# Google Sheets
# サービスアカウントのJSON鍵ファイルへのパス（ローカル実行時のパス。Docker運用時は docker-compose.yml 側で /run/secrets/gcp-service-account.json に上書きされる）
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json
# 対象スプレッドシートのID（URLの /d/ と /edit の間の文字列）
SPREADSHEET_ID=
# データ書き込み先シート名（ガンチャート表示シートとは別に用意すること）
SHEET_NAME=TaskData
