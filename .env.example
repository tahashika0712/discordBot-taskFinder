# Discord Bot
DISCORD_BOT_TOKEN=

# Anthropic Claude API
ANTHROPIC_API_KEY=
# 省略時のデフォルトは claude-opus-4-8。コスト重視なら claude-sonnet-5 / claude-haiku-4-5 に変更可
CLAUDE_MODEL=claude-opus-4-8

# トリガーとなる絵文字（デフォルト: 📋）
TRIGGER_EMOJI=📋

# Google Sheets
# サービスアカウントのJSON鍵ファイルへのパス（ローカル実行時のパス。Docker運用時は docker-compose.yml 側で /run/secrets/gcp-service-account.json に上書きされる）
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json
# 各Discordサーバーの登録先スプレッドシートIDは /set-sheet コマンドで個別に設定するため、ここでの指定は不要
# データ書き込み先シート名（どのスプレッドシートでも共通のタブ名。ガンチャート表示シートとは別に用意すること）
SHEET_NAME=TaskData
# サーバーごとのスプレッドシートID対応を保存するファイルのパス（省略時は ./data/guildSheets.json）
GUILD_SHEET_STORE_PATH=./data/guildSheets.json
